#!/usr/bin/env python3
"""
ollama-cache-dump

Scan common Ollama model cache locations and print per-model disk usage.

By default this checks likely Linux and mounted Windows locations, including:
- $OLLAMA_MODELS
- ~/.ollama/models
- /var/lib/ollama/models
- /mnt/c/Users/*/.ollama/models
- /media/*/Users/*/.ollama/models

Usage:
  scripts/ollama-cache-dump
  scripts/ollama-cache-dump --path ~/.ollama/models --path /var/lib/ollama/models
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
from typing import Iterable, List, Tuple


HOME_ROOT = Path.home().resolve()


def fmt_bytes(n: int) -> str:
    units = ["B", "KB", "MB", "GB", "TB", "PB"]
    val = float(n)
    for unit in units:
        if val < 1024.0 or unit == units[-1]:
            if unit == "B":
                return f"{int(val)} {unit}"
            return f"{val:.2f} {unit}"
        val /= 1024.0
    return f"{n} B"


def existing_dirs(paths: Iterable[Path]) -> List[Path]:
    seen = set()
    out: List[Path] = []
    for p in paths:
        try:
            rp = p.expanduser().resolve()
        except Exception:
            continue
        if rp in seen:
            continue
        seen.add(rp)
        if rp.is_dir():
            out.append(rp)
    return out


def safe_is_dir(path: Path) -> bool:
    try:
        return path.is_dir()
    except OSError:
        return False


def safe_iterdir(path: Path) -> List[Path]:
    try:
        return list(path.iterdir())
    except OSError:
        return []


def is_under_home(path: Path) -> bool:
    try:
        rp = path.expanduser().resolve(strict=False)
    except Exception:
        return False
    return rp == HOME_ROOT or HOME_ROOT in rp.parents


def require_under_home(path: Path, action: str) -> Path:
    rp = path.expanduser().resolve(strict=False)
    if not is_under_home(rp):
        raise ValueError(f"Refusing to {action} outside home: {rp}")
    return rp


def guarded_unlink(path: Path) -> None:
    rp = require_under_home(path, "delete")
    if rp.exists() or rp.is_symlink():
        rp.unlink()


def guarded_symlink(link_path: Path, target_path: Path) -> None:
    # Only the link itself must be under home — the target may be anywhere.
    lp = require_under_home(link_path, "create symlink")
    os.symlink(target_path, lp)


def list_blobs_in_dir(blobs_dir: Path) -> dict:
    """Return {name: path} for all sha256-* files directly in blobs_dir."""
    out = {}
    if not blobs_dir.is_dir():
        return out
    for p in blobs_dir.iterdir():
        if p.name.startswith("sha256-") and p.is_file():
            out[p.name] = p
    return out


def list_blobs_in_home_folder(home_root: Path, exclude_dir: Path) -> List[Path]:
    """Find sha256-* blob files in any .ollama/models/blobs dir under HOME,
    excluding exclude_dir (the canonical global root)."""
    out: List[Path] = []
    exclude_resolved = exclude_dir.resolve()

    for root, dirs, files in os.walk(home_root):
        root_path = Path(root)
        parts = root_path.parts

        if len(parts) < 3 or parts[-3:] != (".ollama", "models", "blobs"):
            continue

        if root_path.resolve() == exclude_resolved:
            continue

        for name in files:
            if name.startswith("sha256-"):
                out.append(root_path / name)

    return sorted(out)


def dedup_home_blobs(global_blobs_root: Path, apply_changes: bool) -> int:
    global_blobs_root = global_blobs_root.expanduser().resolve()
    if not global_blobs_root.is_dir():
        print(f"Global blobs root not found: {global_blobs_root}")
        return 3

    root_blobs = list_blobs_in_dir(global_blobs_root)
    home_blobs = list_blobs_in_home_folder(HOME_ROOT, exclude_dir=global_blobs_root)

    mode = "DEDUP" if apply_changes else "DEDUP-DRY"
    print(f"{mode}: global root = {global_blobs_root}")
    print(f"{mode}: root blobs  = {len(root_blobs)}")
    print(f"{mode}: home blobs  = {len(home_blobs)}")

    if not home_blobs:
        print(f"{mode}: no blobs outside the canonical root — nothing to dedup.")
        return 0

    actions = []
    reclaimable = 0
    skipped = 0

    for src in home_blobs:
        canonical = root_blobs.get(src.name)
        if canonical is None:
            skipped += 1
            print(f"  SKIP (not in root)       {src}")
            continue

        if src.is_symlink():
            try:
                if src.resolve() == canonical.resolve():
                    print(f"  SKIP (already symlinked) {src}")
                    continue
            except OSError:
                pass

        try:
            src_size = src.stat().st_size
            can_size = canonical.stat().st_size
        except OSError:
            skipped += 1
            print(f"  SKIP (stat error)        {src}")
            continue

        if src_size != can_size:
            skipped += 1
            print(f"  SKIP (size mismatch {fmt_bytes(src_size)} vs {fmt_bytes(can_size)}) {src}")
            continue

        actions.append((src, canonical, src_size))
        reclaimable += src_size

    print(f"{mode}: actions     = {len(actions)}")
    print(f"{mode}: skipped     = {skipped}")
    print(f"{mode}: reclaimable = {fmt_bytes(reclaimable)}")

    preview = 20
    for idx, (src, canonical, size) in enumerate(actions[:preview], start=1):
        print(f"  [{idx}] {src} -> {canonical} ({fmt_bytes(size)})")
    if len(actions) > preview:
        print(f"  ... {len(actions) - preview} more action(s)")

    if not apply_changes:
        return 0

    for src, canonical, _ in actions:
        # Both operations are guarded to HOME in helper functions.
        guarded_unlink(src)
        guarded_symlink(src, canonical)

    print(f"DEDUP: applied {len(actions)} replacement(s).")
    return 0


def discover_default_paths() -> List[Path]:
    candidates: List[Path] = []

    env_models = os.environ.get("OLLAMA_MODELS", "").strip()
    if env_models:
        candidates.append(Path(env_models))

    candidates.extend(
        [
            Path.home() / ".ollama" / "models",
            Path("/var/lib/ollama/models"),
            Path("/usr/share/ollama/.ollama/models"),
        ]
    )

    # WSL default mount for Windows user profiles.
    mnt_c_users = Path("/mnt/c/Users")
    if safe_is_dir(mnt_c_users):
        for user_dir in safe_iterdir(mnt_c_users):
            candidates.append(user_dir / ".ollama" / "models")

    # Mounted drives on this workstation often show up under /media.
    media_root = Path("/media")
    if safe_is_dir(media_root):
        for mount in safe_iterdir(media_root):
            users = mount / "Users"
            if safe_is_dir(users):
                for user_dir in safe_iterdir(users):
                    candidates.append(user_dir / ".ollama" / "models")
            homes = mount / "home"
            if safe_is_dir(homes):
                for user_dir in safe_iterdir(homes):
                    candidates.append(user_dir / ".ollama" / "models")

    return existing_dirs(candidates)


def model_ref_from_manifest_path(manifest_file: Path, manifests_root: Path) -> str:
    rel = manifest_file.relative_to(manifests_root)
    parts = rel.parts
    if len(parts) < 2:
        return rel.as_posix()
    registry = parts[0]
    tag = parts[-1]
    repo_path = "/".join(parts[1:-1])
    return f"{registry}/{repo_path}:{tag}"


def digest_to_blob_path(blobs_root: Path, digest: str) -> Path:
    # Example digest: sha256:abc... -> blobs/sha256-abc...
    return blobs_root / digest.replace(":", "-")


def load_manifest(manifest_file: Path) -> dict:
    with manifest_file.open("r", encoding="utf-8") as f:
        return json.load(f)


def scan_store(models_root: Path) -> Tuple[List[dict], int, int]:
    manifests_root = models_root / "manifests"
    blobs_root = models_root / "blobs"

    if not manifests_root.is_dir() or not blobs_root.is_dir():
        return [], 0, 0

    manifests: List[Path] = [p for p in manifests_root.rglob("*") if p.is_file()]
    rows: List[dict] = []

    total_declared = 0
    total_on_disk = 0

    for mf in sorted(manifests):
        try:
            payload = load_manifest(mf)
        except Exception:
            continue

        model_ref = model_ref_from_manifest_path(mf, manifests_root)
        layers = payload.get("layers", []) or []

        declared = 0
        on_disk = 0
        missing = 0

        for layer in layers:
            digest = str(layer.get("digest", ""))
            size = int(layer.get("size", 0) or 0)
            declared += size

            if digest:
                bp = digest_to_blob_path(blobs_root, digest)
                if bp.is_file():
                    try:
                        on_disk += bp.stat().st_size
                    except OSError:
                        missing += 1
                else:
                    missing += 1

        total_declared += declared
        total_on_disk += on_disk

        rows.append(
            {
                "model": model_ref,
                "declared_bytes": declared,
                "on_disk_bytes": on_disk,
                "missing_blobs": missing,
                "manifest": str(mf),
            }
        )

    return rows, total_declared, total_on_disk


def print_store_report(models_root: Path) -> None:
    rows, total_declared, total_on_disk = scan_store(models_root)
    if not rows:
        return

    blobs_root = models_root / "blobs"
    manifests_root = models_root / "manifests"

    blob_dir_size = 0
    for p in blobs_root.rglob("*"):
        if p.is_file():
            try:
                blob_dir_size += p.stat().st_size
            except OSError:
                pass

    print(f"Store: {models_root}")
    print(f"  Manifests: {len(rows)}")
    print(f"  Blob dir size (unique): {fmt_bytes(blob_dir_size)}")
    print(f"  Manifest declared total: {fmt_bytes(total_declared)}")
    print(f"  Manifest on-disk total: {fmt_bytes(total_on_disk)}")
    print("  Models:")

    for row in sorted(rows, key=lambda r: r["on_disk_bytes"], reverse=True):
        missing = row["missing_blobs"]
        miss = f", missing_blobs={missing}" if missing else ""
        print(
            f"    - {row['model']} | on_disk={fmt_bytes(row['on_disk_bytes'])}"
            f" | declared={fmt_bytes(row['declared_bytes'])}{miss}"
        )

    print(f"  Manifests root: {manifests_root}")
    print(f"  Blobs root: {blobs_root}")
    print()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Dump Ollama cache models and sizes.")
    parser.add_argument(
        "--path",
        action="append",
        default=[],
        help="Explicit models root path (can be repeated). Example: ~/.ollama/models",
    )
    parser.add_argument(
        "--dedup-dry",
        action="store_true",
        help="Preview dedup under HOME only: replace duplicate blob files with symlinks to global blobs root.",
    )
    parser.add_argument(
        "--dedup",
        action="store_true",
        help="Apply dedup under HOME only: delete duplicate files and create symlinks to global blobs root.",
    )
    parser.add_argument(
        "--global-blobs-root",
        default="/usr/share/ollama/.ollama/models/blobs",
        help="Canonical system blobs root used as dedup target (e.g. /usr/share/ollama/.ollama/models/blobs).",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    if args.dedup and args.dedup_dry:
        print("Use only one of --dedup-dry or --dedup.")
        return 2

    if args.dedup_dry or args.dedup:
        return dedup_home_blobs(Path(args.global_blobs_root), apply_changes=args.dedup)

    if args.path:
        roots = existing_dirs(Path(p) for p in args.path)
    else:
        roots = discover_default_paths()

    if not roots:
        print("No Ollama model stores found.")
        return 1

    found_any = False
    for root in roots:
        rows, _, _ = scan_store(root)
        if rows:
            found_any = True
            print_store_report(root)

    if not found_any:
        print("No valid Ollama stores with both manifests/ and blobs/ found.")
        print("Checked paths:")
        for r in roots:
            print(f"  - {r}")
        return 2

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
